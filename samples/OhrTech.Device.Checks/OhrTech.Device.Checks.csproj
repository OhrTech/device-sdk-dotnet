<Project Sdk="Microsoft.NET.Sdk">
  <!-- The device checks of OhrTech.Device, as the Kotlin library's: start ChecksActivity with the extra "check" set to a check's
       name (and its arguments as more extras); it logs "CHECK PASS|FAIL name detail" (tag OhrSdkCheck). Build it as another hub
       app with the ApplicationId and ApplicationVersion properties. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId Condition="'$(ApplicationId)' == ''">net.ohrtech.device.dotnet.checks</ApplicationId>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationTitle>OhrTech SDK (.NET)</ApplicationTitle>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OhrTech.Device/OhrTech.Device.csproj" />
  </ItemGroup>
</Project>
